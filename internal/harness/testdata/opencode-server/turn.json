    {"type": "session.execution.started", "t": 1100, "data": {"sessionID": "ses_a"}},
    {"type": "permission.asked", "t": 1200, "dir": "/work/app", "data": {"id": "per_1", "sessionID": "ses_a", "action": "shell", "resources": ["go test ./..."], "save": ["go test *"], "source": {"type": "tool", "messageID": "msg_2", "id": "call_1"}}},
    {"type": "permission.replied", "t": 1300, "dir": "/work/app", "data": {"sessionID": "ses_a", "requestID": "per_1", "reply": "once"}},
    {"type": "permission.asked", "t": 1250, "dir": "/work/app", "data": {"id": "per_1", "sessionID": "ses_a", "action": "shell", "resources": ["go test ./..."]}},
    {"type": "session.execution.succeeded", "t": 1400, "data": {"sessionID": "ses_a"}},
    {"type": "session.viewed", "t": 1450, "data": {"sessionID": "ses_a"}},
    {"type": "session.execution.started", "t": 2000, "data": {"sessionID": "ses_a"}},
    {"type": "session.retry.scheduled", "t": 2050, "data": {"sessionID": "ses_a"}},
    {"type": "permission.asked", "t": 2100, "dir": "/work/app", "data": {"id": "per_2", "sessionID": "ses_a", "action": "edit", "resources": ["/work/app/main.go"]}},
    {"type": "permission.replied", "t": 2200, "data": {"sessionID": "ses_a", "requestID": "per_2", "reply": "reject"}},
    {"type": "session.execution.failed", "t": 2300, "data": {"sessionID": "ses_a"}},
    {"type": "session.execution.started", "t": 3000, "data": {"sessionID": "ses_a"}},
    {"type": "session.execution.interrupted", "t": 3100, "data": {"sessionID": "ses_a"}},
    {"type": "session.tool.called", "t": 3150, "data": {"sessionID": "ses_a"}},
    {"type": "session.deleted", "t": 3200, "data": {"sessionID": "ses_a"}}
