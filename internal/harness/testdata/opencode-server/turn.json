  "expect": [
    {"harness": "opencode", "session": "ses_a", "state": "idle", "version": "2.2.5"},
    {"harness": "opencode", "session": "ses_a", "state": "working", "version": "2.2.5"},
    {"harness": "opencode", "session": "ses_a", "state": "blocked", "kind": "permission", "version": "2.2.5",
