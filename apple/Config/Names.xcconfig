// The one place that names the app. A rename is an edit here and nowhere else.

APP_DISPLAY_NAME = Flightdeck
APP_BUNDLE_PREFIX = com.nkmkdigital

APP_BUNDLE_ID = $(APP_BUNDLE_PREFIX).flightdeck
// APP_SHARE_BUNDLE_ID = $(APP_BUNDLE_ID).share
// Shared by the app and its extensions (widgets, notification service).
APP_GROUP_ID = group.$(APP_BUNDLE_ID)
// Push. The iOS app has only an App Store profile, which carries production.
APP_APS_ENVIRONMENT = production

MARKETING_VERSION = 0.1.0
// Local and simulator builds only. build.sh and testflight.sh set the build
// number to the UTC time (YYYYMMDDHHMM), so it rises on every archive.
CURRENT_PROJECT_VERSION = 1
