// Shared by every target. Names come from Names.xcconfig; signing comes from
// the untracked Local.xcconfig (copy Local.example.xcconfig). With no
// Local.xcconfig the build signs ad hoc.

#include "Names.xcconfig"

MACOSX_DEPLOYMENT_TARGET = 26.0
IPHONEOS_DEPLOYMENT_TARGET = 26.1
// Swift 6 language mode with strict concurrency on every target, and the Swift
// 6.2 approachable-concurrency features (nonisolated async runs on the caller's
// actor; isolated conformances are inferred). Every target keeps nonisolated as
// its default isolation: the app types are main-actor already through SwiftUI
// and UIKit, and the extensions and the shared intents run off the main actor.
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
// No get-task-allow in a release: notarization refuses it.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

APP_MAC_PROFILE =
APP_IOS_PROFILE =
APP_NSE_PROFILE =
APP_WIDGET_PROFILE =

#include? "Local.xcconfig"
