// Copy to Local.xcconfig (untracked) and fill in. Never commit Local.xcconfig.

// 1. Signing. Find the identities with:
//    security find-identity -v -p codesigning
//    The Mac app ships with Developer ID; the iOS app ships through App Store
//    Connect. Simulator builds stay ad hoc.
DEVELOPMENT_TEAM = <TEAM_ID>
CODE_SIGN_IDENTITY[sdk=macosx*] = Developer ID Application
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Distribution
// A secure timestamp; notarization requires one.
OTHER_CODE_SIGN_FLAGS[sdk=macosx*] = --timestamp

// 2. iOS: an App Store provisioning profile for each bundle ID, installed on
//    this Mac. Names as `security cms -D -i <file>` prints them under Name.
// APP_IOS_PROFILE = <iOS app profile name>
//    The notification service extension and the Live Activity widget have
//    bundle IDs of their own (Names.xcconfig), so each needs its own profile.
// APP_NSE_PROFILE = <notification service profile name>
// APP_WIDGET_PROFILE = <widget extension profile name>
//    Debug builds sign with aps-environment development (Names.xcconfig), so
//    a Debug build for a device needs development profiles and an Apple
//    Development identity; App Store profiles fit Release only:
// CODE_SIGN_IDENTITY[config=Debug][sdk=iphoneos*] = Apple Development
// APP_IOS_PROFILE[config=Debug] = <iOS development profile name>
// APP_NSE_PROFILE[config=Debug] = <notification service development profile name>
// APP_WIDGET_PROFILE[config=Debug] = <widget development profile name>

// 3. macOS: a Developer ID profile, only when an entitlement needs one
//    (keychain groups, iCloud). Plain Developer ID signing needs none.
// APP_MAC_PROFILE = <macOS app profile name>
