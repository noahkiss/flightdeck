// Flightdeck.xcconfig - flightdeck's identity and build-time switches.
//
// Tracked, unlike DeveloperSettings.xcconfig. Identity.xcconfig includes this
// file just before that optional override, so it replaces upstream's
// ROOTSHELL_* defaults for every target and configuration, and a local
// DeveloperSettings.xcconfig still wins over it. Set only variables here:
// settings assigned later in the chain (Base.xcconfig, the variant files)
// would win over a plain assignment.

// Apple Developer team.
ROOTSHELL_DEVELOPMENT_TEAM = 2Z88BYP37C

// Bundle identifier namespace. Every bundle id, app group and keychain group
// derives from it; the app is $(ROOTSHELL_ORG_IDENTIFIER).rootshell. Change the
// prefix here and nowhere else.
ROOTSHELL_ORG_IDENTIFIER = com.nkmkdigital.flightdeck

// App group shared by the app and its extensions. Upstream derives
// group.<org>.ghostty.
ROOTSHELL_DEFAULT_APP_GROUP = group.com.nkmkdigital.flightdeck

// CloudKit container. Set wholesale, not derived. CloudKit sync stays off by
// default.
ROOTSHELL_ICLOUD_CONTAINER = iCloud.com.nkmkdigital.flightdeck

// Home-screen and menu-bar name of the app targets.
FLIGHTDECK_DISPLAY_NAME = flightdeck

// Entitlements. Each "-flightdeck" file is upstream's file minus push
// (aps-environment), upstream's associated domains and, in the iOS App Store
// file, the request-gated multicast grant. scripts/flightdeck-entitlements.py
// derives them; CI fails when they drift from upstream.
// ROOTSHELL_APP_ENTITLEMENTS_SUFFIX is upstream's switch for the iOS App Store
// file; FLIGHTDECK_ENTITLEMENTS_SUFFIX covers the Mac Catalyst and Standalone
// files, which upstream does not switch.
ROOTSHELL_APP_ENTITLEMENTS_SUFFIX = -flightdeck
FLIGHTDECK_ENTITLEMENTS_SUFFIX = -flightdeck

// Compile-time switch for flightdeck's feature gates. Every gate is an
// `#if FLIGHTDECK` block in Swift. It turns off OSC 52 clipboard reads, croc,
// the AI and voice agents, Tailscale and HTTPS capture. $(inherited) keeps the
// DEBUG condition that project-level settings add.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) FLIGHTDECK
