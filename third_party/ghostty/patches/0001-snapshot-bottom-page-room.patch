+    /// Return the advertised capacity with room for more rows: as many as a
+    /// standard page of these columns holds, while the page still fits in the
+    /// memory it takes anyway: a standard page, or for a page enlarged past
+    /// that (more styles or graphemes), the largest page. A decoded page at
+    /// its exact capacity is full, so the next row written below it would
+    /// start a new page and the unused rest of this page's memory would stay
+    /// allocated and counted against the scrollback limit. Use it for the page
+    /// that holds the bottom of the screen. Returns the exact capacity when
+    /// there is no room.
+    pub fn capacityWithRoom(self: *const Decoder) TerminalPageCapacity {
+        const exact = self.capacity();
+        const std_size = TerminalPage.layout(terminal_page.std_capacity).total_size;
+        const limit = if (TerminalPage.layout(exact).total_size > std_size)
+            max_page_size
+        else
+            std_size;
+        const std_rows = (terminal_page.std_capacity.adjust(
+            .{ .cols = exact.cols },
+        ) catch return exact).rows;
+        if (std_rows <= exact.rows) return exact;
+        var cap = exact;
+        cap.rows = std_rows;
+        while (cap.rows > exact.rows and
+            TerminalPage.layout(cap).total_size > limit) cap.rows -= 1;
+        return cap;
+    }
+
     /// Largest remaining PAGE payload staged into one contiguous buffer.
     /// This comfortably covers every payload a standard-capacity page can
     /// produce while keeping the allocation an untrusted length can force
     /// far below the record framing's four-byte length limit.
     const max_staged_payload = 8 * 1024 * 1024;
 
