+    /// The destination must be freshly initialized with `capacity`, or with
+    /// `capacityWithRoom`, which differs only in more rows. `alloc`
     /// is used only for temporary staging, ID remaps, and integrity-check
     /// storage.
     pub fn decode(
         self: *Decoder,
         destination: *TerminalPage,
         alloc: Allocator,
     ) DecodeError!void {
-        if (!std.meta.eql(destination.capacity, self.capacity())) {
-            return error.InvalidDestinationCapacity;
+        {
+            var want = self.capacity();
+            if (destination.capacity.rows >= want.rows) want.rows = destination.capacity.rows;
+            if (!std.meta.eql(destination.capacity, want)) {
+                return error.InvalidDestinationCapacity;
+            }
         }
 
