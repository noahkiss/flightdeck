{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flightdeck:blocks:1",
  "title": "Flightdeck block vocabulary 1",
  "description": "A module's block tree, vocabulary version 1. Generated by internal/apigen from api/modules/vocab.go; do not edit. Rules JSON Schema cannot state (at most 500 blocks, depth 12, 65536 bytes, unique ids, steps.current at most steps.total) are checked by modules.ValidateTree. See docs/specs/modules.md 6 and 9.",
  "x-vocabulary": 1,
  "$ref": "#/$defs/block",
  "$defs": {
    "block": {
      "description": "Any block. Its type picks the definition that applies.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "stack",
            "section",
            "row",
            "text",
            "badge",
            "metric",
            "metrics",
            "progress",
            "button",
            "toggle",
            "field",
            "list",
            "log"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "stack"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/stack"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "section"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/section"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "row"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/row"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/text"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "badge"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/badge"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "metric"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/metric"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "metrics"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/metrics"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "progress"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/progress"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "button"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/button"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "toggle"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/toggle"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "field"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/field"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/list"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "log"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/log"
          }
        }
      ]
    },
    "stack": {
      "description": "Children in a column or a row.",
      "type": "object",
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stack"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "axis": {
          "description": "vertical (the default) or horizontal.",
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 100
        },
        "gap": {
          "description": "Space between children in steps: 4 points each in the app; a blank line or column per step in the terminal.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "section": {
      "description": "Children under a header.",
      "type": "object",
      "required": [
        "type",
        "title",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "section"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 100
        },
        "collapsed": {
          "description": "Starts collapsed. The client keeps the person's choice by block id.",
          "type": "boolean"
        }
      }
    },
    "row": {
      "description": "One list row: symbol, title, body and a trailing value.",
      "type": "object",
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "row"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "maxLength": 300
        },
        "trailing": {
          "description": "Right-aligned.",
          "type": "string",
          "maxLength": 40
        },
        "tint": {
          "$ref": "#/$defs/tint"
        },
        "action": {
          "description": "Sent when the row is tapped.",
          "$ref": "#/$defs/action"
        }
      }
    },
    "text": {
      "description": "A run of text.",
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "style": {
          "enum": [
            "body",
            "caption",
            "mono",
            "title"
          ]
        }
      }
    },
    "badge": {
      "description": "A short label in a capsule.",
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "badge"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "text": {
          "type": "string",
          "maxLength": 40
        },
        "tint": {
          "$ref": "#/$defs/tint"
        }
      }
    },
    "metric": {
      "description": "A labelled value.",
      "type": "object",
      "required": [
        "type",
        "label",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "metric"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "value": {
          "description": "Formatted by the module.",
          "type": "string",
          "maxLength": 40
        },
        "unit": {
          "type": "string",
          "maxLength": 16
        },
        "tint": {
          "$ref": "#/$defs/tint"
        }
      }
    },
    "metrics": {
      "description": "A grid of up to six metrics.",
      "type": "object",
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "metrics"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          },
          "minItems": 1,
          "maxItems": 6
        }
      }
    },
    "progress": {
      "description": "A bar from a fraction, or a step count.",
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "progress"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "value": {
          "description": "0 to 1.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "steps": {
          "description": "current of total; current is at most total.",
          "$ref": "#/$defs/steps"
        },
        "ends_at": {
          "description": "When it ends; the client counts down without a new tree.",
          "type": "string",
          "format": "date-time"
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "steps"
          ]
        }
      ]
    },
    "button": {
      "description": "A button; a key hint in the terminal.",
      "type": "object",
      "required": [
        "type",
        "title",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "button"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "role": {
          "enum": [
            "normal",
            "destructive"
          ]
        },
        "confirm": {
          "description": "A question the client asks before it sends the action.",
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "toggle": {
      "description": "An on or off switch.",
      "type": "object",
      "required": [
        "type",
        "title",
        "value",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "toggle"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "value": {
          "type": "boolean"
        },
        "action": {
          "description": "The client adds value, the new state, to args.",
          "$ref": "#/$defs/action"
        }
      }
    },
    "field": {
      "description": "A text field; Return sends it.",
      "type": "object",
      "required": [
        "type",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "field"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        },
        "action": {
          "description": "The client adds text, what was typed, to args.",
          "$ref": "#/$defs/action"
        }
      }
    },
    "list": {
      "description": "Children as a list.",
      "type": "object",
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "list"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 200
        },
        "empty": {
          "description": "Shown when there are no children.",
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "log": {
      "description": "Lines of monospaced text.",
      "type": "object",
      "required": [
        "type",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "log"
        },
        "id": {
          "description": "Stable across renders when the block has view state or an action. Unique in a tree.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "fallback": {
          "description": "Text a client shows when it does not know the block's type.",
          "type": "string",
          "maxLength": 120
        },
        "stale_after": {
          "description": "Seconds after the tree arrives when the client greys the block.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 500
        },
        "follow": {
          "description": "Keep the newest line in view.",
          "type": "boolean"
        }
      }
    },
    "tint": {
      "description": "A colour by meaning, or a raw #RRGGBB colour.",
      "anyOf": [
        {
          "enum": [
            "accent",
            "muted",
            "working",
            "blocked",
            "done",
            "idle",
            "error",
            "warning"
          ]
        },
        {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      ]
    },
    "symbol": {
      "description": "An SF Symbol name. The terminal shows nothing for a name it does not know.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"
    },
    "steps": {
      "type": "object",
      "required": [
        "total",
        "current"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "current": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "action": {
      "description": "Sent when the block is used. A name the module defines goes to its act function; a client.* name is handled by the client.",
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "args": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "client.open_session"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "client.open_pane"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "client.copy"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "client.open_url"
              }
            }
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^https://[^\\s]+$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "pattern": "^client\\."
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "enum": [
                  "client.open_session",
                  "client.open_pane",
                  "client.copy",
                  "client.open_url"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
