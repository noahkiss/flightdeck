{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flightdeck:module-manifest",
  "title": "Flightdeck module manifest",
  "description": "A module's manifest.toml. Generated by internal/apigen from api/modules/manifest.go; do not edit. Rules JSON Schema cannot state (unique setting keys, a choice default among its choices) are checked by modules.ParseManifest. See docs/specs/modules.md 5 and 9.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "blocks",
    "bridge",
    "places"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Unique on a hab.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "version": {
      "description": "Semver. Shown; not used for gating.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "blocks": {
      "description": "The lowest block vocabulary version the module needs.",
      "type": "integer",
      "minimum": 1
    },
    "bridge": {
      "description": "The lowest bridge version the module needs.",
      "type": "integer",
      "minimum": 1
    },
    "powers": {
      "description": "What the module may do beyond reading hab data and keeping state.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "act",
          "exec",
          "fetch"
        ]
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "board",
          "host",
          "session",
          "sheet"
        ]
      }
    },
    "refresh": {
      "description": "Seconds between scheduled refreshes; below 5 is raised to 5.",
      "type": "integer",
      "minimum": 1
    },
    "events": {
      "description": "Hab event types that trigger a refresh.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "enum": [
              "text",
              "number",
              "toggle",
              "choice"
            ]
          },
          "default": {
            "description": "Its type follows kind: a string for text and choice, a number, or a boolean for toggle."
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "text"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "number"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "toggle"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "choice"
                }
              }
            },
            "then": {
              "required": [
                "choices"
              ],
              "properties": {
                "default": {
                  "type": "string"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "choices"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
